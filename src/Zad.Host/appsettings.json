{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tenancy": {
    "RootDomain": "localhost"
  },
  "Jobs": {
    "ServerEnabled": true,
    "WorkerCount": 2,
    "Queues": [ "default" ],
    "DefaultRetryAttempts": 5
  },
  "Adhkar": {
    "RotationCron": "0 * * * * *"
  }
}
