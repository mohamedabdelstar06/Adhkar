# Copy to .env (git-ignored). scripts/dev-up.sh does this if .env is missing.
# Placeholder values for LOCAL development only. Never reuse them anywhere else.

# SQL Server container (compose profile `deps`). Needs 8+ chars with upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=Local_Dev_Only_1!

# OpenObserve container root account (compose profile `deps`).
ZO_ROOT_USER_EMAIL=dev@zad.localhost
ZO_ROOT_USER_PASSWORD=Local_Dev_Only_2!
